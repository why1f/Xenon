# Copy to xenon.toml before starting Xenon.
grpc_addr = "127.0.0.1:50051"
http_addr = "127.0.0.1:18081"
database_path = "data/xenon.db"

[subscription_http]
# Enable native HTTPS, or leave disabled behind a TLS reverse proxy on loopback/private IP.
tls_enabled = false
cert_path = "/etc/xenon/tls/subscription.crt"
key_path = "/etc/xenon/tls/subscription.key"
# Set this to the externally reachable origin/base path used in generated subscription URLs.
public_base_url = ""
requests_per_minute_per_ip = 120
requests_per_minute_per_token = 60

[traffic_retention]
# Raw rows are short-term correction/audit data; aggregates preserve accounting history.
maintenance_interval_seconds = 3600
raw_event_days = 30
interface_snapshot_days = 30
system_snapshot_days = 7
# 0 keeps the aggregate granularity indefinitely.
hourly_aggregate_days = 0
daily_aggregate_days = 0

[backup]
# Creates an immediate backup at startup, then repeats at this interval.
enabled = false
directory = "data/backups"
interval_hours = 24
retain_count = 7

[tls]
# Development only. Production must enable mTLS and provide all three files.
enabled = false
cert_path = "/etc/xenon/tls/server.crt"
key_path = "/etc/xenon/tls/server.key"
client_ca_path = "/etc/xenon/tls/clients-ca.crt"

[registration]
# Development-only shortcut. Disable this in production.
allow_insecure_dev_token = true

[enrollment]
# Requires TLS and access to the client CA private key.
enabled = false
addr = "127.0.0.1:50052"
ca_cert_path = "/etc/xenon/tls/clients-ca.crt"
ca_key_path = "/etc/xenon/tls/clients-ca.key"
certificate_valid_days = 90

[agent_install]
# Enable only after publishing the script, CA, and architecture-specific Agent binary.
enabled = false
script_url = "https://downloads.example.com/install-agent.sh"
binary_url = "https://downloads.example.com/xenon-agent-x86_64"
binary_sha256 = ""
binary_version = ""
ca_url = "https://downloads.example.com/panel-ca.crt"
panel_endpoint = "https://panel.example.com:50051"
enrollment_endpoint = "https://panel.example.com:50052"
server_name = "panel.example.com"
